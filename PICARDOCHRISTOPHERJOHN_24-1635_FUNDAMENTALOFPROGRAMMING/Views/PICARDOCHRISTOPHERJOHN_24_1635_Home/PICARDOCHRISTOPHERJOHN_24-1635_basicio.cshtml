@model PICARDOCHRISTOPHERJOHN_24_1635_BasicIOPageModel

@{
    ViewData["Title"] = "Basic Input-Output";
    ViewData["Topic"] = "BasicIO";
}

<h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Basic Input-Output</h1>
<p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-700 sm:text-lg">Five simple examples: a calculator, BMI, temperature conversion, a greeting, and circle measurements.</p>
<details class="example-menu mt-5">
    <summary class="min-h-11 cursor-pointer py-2 font-semibold">Examples on this page</summary>
    <nav aria-label="Examples on this page" class="mt-2 flex flex-wrap gap-x-5 gap-y-3">
    <a class="inline-flex min-h-11 items-center text-course-green underline underline-offset-4" href="#calculator">Basic Calculator</a>
    <a class="inline-flex min-h-11 items-center text-course-green underline underline-offset-4" href="#bmi">BMI Calculator</a>
    <a class="inline-flex min-h-11 items-center text-course-green underline underline-offset-4" href="#temperature">Temperature Converter</a>
    <a class="inline-flex min-h-11 items-center text-course-green underline underline-offset-4" href="#greeting">Personalized Greeting</a>
    <a class="inline-flex min-h-11 items-center text-course-green underline underline-offset-4" href="#circle">Circle Area &amp; Circumference</a>
    </nav>
</details>
<partial name="PICARDOCHRISTOPHERJOHN_24-1635_validation" />

<section id="calculator" aria-labelledby="calculator-title" class="example">
    <h2 id="calculator-title" class="text-2xl font-semibold tracking-tight">Basic Calculator</h2>
    <p class="mt-3 leading-relaxed text-stone-700">Add, subtract, multiply, or divide two numbers.</p>
    <form asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Home" asp-action="BasicIO" asp-fragment="calculator" method="post" class="example-form">
            <div>
                <label asp-for="Calculator.FirstNumber" class="form-label">First number</label>
                <input asp-for="Calculator.FirstNumber" type="number" step="any" required class="form-input" aria-describedby="Calculator_FirstNumber-error" />
                <span asp-validation-for="Calculator.FirstNumber" id="Calculator_FirstNumber-error" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Calculator.Operation" class="form-label">Operation</label>
                <select asp-for="Calculator.Operation" class="form-input">
                    <option value="add">Add (+)</option>
                    <option value="subtract">Subtract (-)</option>
                    <option value="multiply">Multiply (×)</option>
                    <option value="divide">Divide (÷)</option>
                </select>
                <span asp-validation-for="Calculator.Operation" id="Calculator_Operation-error" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Calculator.SecondNumber" class="form-label">Second number</label>
                <input asp-for="Calculator.SecondNumber" type="number" step="any" required class="form-input" aria-describedby="Calculator_SecondNumber-error" />
                <span asp-validation-for="Calculator.SecondNumber" id="Calculator_SecondNumber-error" class="field-error"></span>
            </div>
        <button type="submit" class="action-button">Calculate</button>
    </form>
    @if (Model.Calculator.Result.HasValue)
    {
        <pre class="example-output" role="status" tabindex="-1"><output>Result: @Model.Calculator.Result.Value.ToString("G29")</output></pre>
    }
    <details class="mt-6">
        <summary class="min-h-11 cursor-pointer py-2 font-semibold">See the C# logic</summary>
        <pre class="code-example"><code>switch (Operation)
{
    case "add": Result = first + second; break;
    case "subtract": Result = first - second; break;
    case "multiply": Result = first * second; break;
    case "divide": Result = first / second; break;
}</code></pre>
    </details>
</section>

<section id="bmi" aria-labelledby="bmi-title" class="example">
    <h2 id="bmi-title" class="text-2xl font-semibold tracking-tight">BMI Calculator</h2>
    <p class="mt-3 leading-relaxed text-stone-700">Enter weight in kilograms and height in centimetres. This example calculates the number only.</p>
    <form asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Home" asp-action="Bmi" asp-fragment="bmi" method="post" class="example-form">
            <div>
                <label asp-for="Bmi.Weight" class="form-label">Weight (kg)</label>
                <input asp-for="Bmi.Weight" type="number" step="any" min="1" max="500" required class="form-input" aria-describedby="Bmi_Weight-error" />
                <span asp-validation-for="Bmi.Weight" id="Bmi_Weight-error" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Bmi.Height" class="form-label">Height (cm)</label>
                <input asp-for="Bmi.Height" type="number" step="any" min="50" max="300" required class="form-input" aria-describedby="Bmi_Height-error" />
                <span asp-validation-for="Bmi.Height" id="Bmi_Height-error" class="field-error"></span>
            </div>
        <button type="submit" class="action-button">Calculate BMI</button>
    </form>
    @if (Model.Bmi.Result != null)
    {
        <pre class="example-output" role="status" tabindex="-1"><output>@Model.Bmi.Result</output></pre>
    }
    <details class="mt-6">
        <summary class="min-h-11 cursor-pointer py-2 font-semibold">See the C# logic</summary>
        <pre class="code-example"><code>double heightInMetres = Height.GetValueOrDefault() / 100;
double bmi = Weight.GetValueOrDefault() / (heightInMetres * heightInMetres);
Result = $"BMI: {bmi:F2} kg/m²";</code></pre>
    </details>
</section>

<section id="temperature" aria-labelledby="temperature-title" class="example">
    <h2 id="temperature-title" class="text-2xl font-semibold tracking-tight">Temperature Converter</h2>
    <p class="mt-3 leading-relaxed text-stone-700">Convert between Celsius and Fahrenheit.</p>
    <form asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Home" asp-action="Temperature" asp-fragment="temperature" method="post" class="example-form">
            <div>
                <label asp-for="Temperature.Value" class="form-label">Temperature</label>
                <input asp-for="Temperature.Value" type="number" step="any" min="-1000000" max="1000000" required class="form-input" aria-describedby="Temperature_Value-error" />
                <span asp-validation-for="Temperature.Value" id="Temperature_Value-error" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Temperature.Direction" class="form-label">Conversion</label>
                <select asp-for="Temperature.Direction" class="form-input">
                    <option value="c-to-f">Celsius to Fahrenheit</option>
                    <option value="f-to-c">Fahrenheit to Celsius</option>
                </select>
                <span asp-validation-for="Temperature.Direction" id="Temperature_Direction-error" class="field-error"></span>
            </div>
        <button type="submit" class="action-button">Convert temperature</button>
    </form>
    @if (Model.Temperature.Result != null)
    {
        <pre class="example-output" role="status" tabindex="-1"><output>@Model.Temperature.Result</output></pre>
    }
    <details class="mt-6">
        <summary class="min-h-11 cursor-pointer py-2 font-semibold">See the C# logic</summary>
        <pre class="code-example"><code>double temperature = Value.GetValueOrDefault();
if (Direction == "c-to-f")
    Result = $"{temperature * 9 / 5 + 32:F2} °F";
else
    Result = $"{(temperature - 32) * 5 / 9:F2} °C";</code></pre>
    </details>
</section>

<section id="greeting" aria-labelledby="greeting-title" class="example">
    <h2 id="greeting-title" class="text-2xl font-semibold tracking-tight">Personalized Greeting</h2>
    <p class="mt-3 leading-relaxed text-stone-700">Enter your name and display a greeting.</p>
    <form asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Home" asp-action="Greeting" asp-fragment="greeting" method="post" class="example-form">
            <div>
                <label asp-for="Greeting.Name" class="form-label">Your name</label>
                <input asp-for="Greeting.Name" type="text" maxlength="60" required class="form-input" aria-describedby="Greeting_Name-error" />
                <span asp-validation-for="Greeting.Name" id="Greeting_Name-error" class="field-error"></span>
            </div>
        <button type="submit" class="action-button">Generate greeting</button>
    </form>
    @if (Model.Greeting.Result != null)
    {
        <pre class="example-output" role="status" tabindex="-1"><output>@Model.Greeting.Result</output></pre>
    }
    <details class="mt-6">
        <summary class="min-h-11 cursor-pointer py-2 font-semibold">See the C# logic</summary>
        <pre class="code-example"><code>Result = $"Hello, {Name?.Trim()}! Welcome to Fundamental of Programming.";</code></pre>
    </details>
</section>

<section id="circle" aria-labelledby="circle-title" class="example">
    <h2 id="circle-title" class="text-2xl font-semibold tracking-tight">Circle Area &amp; Circumference</h2>
    <p class="mt-3 leading-relaxed text-stone-700">Enter a radius in any unit. Area uses square units; circumference uses the same unit as the radius.</p>
    <form asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Home" asp-action="Circle" asp-fragment="circle" method="post" class="example-form">
            <div>
                <label asp-for="Circle.Radius" class="form-label">Radius</label>
                <input asp-for="Circle.Radius" type="number" step="any" min="0.01" max="1000000" required class="form-input" aria-describedby="Circle_Radius-error" />
                <span asp-validation-for="Circle.Radius" id="Circle_Radius-error" class="field-error"></span>
            </div>
        <button type="submit" class="action-button">Calculate circle</button>
    </form>
    @if (Model.Circle.Result != null)
    {
        <pre class="example-output" role="status" tabindex="-1"><output>@Model.Circle.Result</output></pre>
    }
    <details class="mt-6">
        <summary class="min-h-11 cursor-pointer py-2 font-semibold">See the C# logic</summary>
        <pre class="code-example"><code>double radius = Radius.GetValueOrDefault();
double area = Math.PI * radius * radius;
double circumference = 2 * Math.PI * radius;
Result = $"Area: {area:F2} square units; Circumference: {circumference:F2} units";</code></pre>
    </details>
</section>
