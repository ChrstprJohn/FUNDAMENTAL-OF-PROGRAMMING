@model PICARDOCHRISTOPHERJOHN_24_1635_ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<h1 class="text-3xl font-semibold tracking-tight">Something went wrong</h1>
<p class="mt-5 leading-relaxed">We could not complete your request. Please return to the course and try again.</p>
@if (!string.IsNullOrEmpty(Model.RequestId))
{
    <p class="mt-4 text-sm text-stone-600">Request ID: <code class="break-all">@Model.RequestId</code></p>
}
<a class="mt-6 inline-flex min-h-11 items-center bg-course-green px-5 py-2 font-semibold text-white hover:bg-course-dark" asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Home" asp-action="BasicIO">Back to course</a>
