@if (!ViewData.ModelState.IsValid)
{
    <div class="error-summary" role="alert" tabindex="-1" aria-labelledby="validation-title">
        <h2 id="validation-title" class="text-xl font-semibold">Check your input</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5">
            @foreach (var entry in ViewData.ModelState)
            {
                @foreach (var error in entry.Value.Errors)
                {
                    <li>
                        @if (string.IsNullOrEmpty(entry.Key))
                        {
                            @error.ErrorMessage
                        }
                        else
                        {
                            <a class="underline underline-offset-4" href="@("#" + entry.Key.Replace('.', '_').Replace('[', '_').Replace(']', '_'))">@error.ErrorMessage</a>
                        }
                    </li>
                }
            }
        </ul>
    </div>
}
