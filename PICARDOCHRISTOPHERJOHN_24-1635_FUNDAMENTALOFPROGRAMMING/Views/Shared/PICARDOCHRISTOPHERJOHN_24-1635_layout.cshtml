<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Christopher John Picardo's Fundamental of Programming course project: input-output, decisions, loops, and arrays." />
    <title>@ViewData["Title"] | Fundamental of Programming</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-white text-stone-900 antialiased">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="grid min-h-24 items-center gap-3 bg-course-dark py-4 text-white lg:grid-cols-[248px_minmax(0,1fr)]">
        <a class="block min-w-0 px-5 text-lg font-bold leading-snug tracking-tight lg:px-6" asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_BasicIO" asp-action="Index">Fundamental of Programming<span>.</span></a>
        <p class="px-5 text-sm text-white lg:px-8 lg:text-right">Christopher John Picardo <span class="ml-2">24-1635</span></p>
    </header>
    <div class="lg:grid lg:grid-cols-[248px_minmax(0,1fr)]">
        <aside class="bg-course-sidebar px-5 py-5 lg:min-h-[calc(100vh-96px)] lg:px-6 lg:py-9">
            <details class="topic-menu lg:sticky lg:top-6">
                <summary class="cursor-pointer py-2 font-semibold">Course contents</summary>
                <nav aria-label="Course contents" class="mt-4 flex flex-col gap-1">
                    <a class="topic-link" aria-current="@(ViewData["Topic"] as string == "BasicIO" ? "page" : null)" asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_BasicIO" asp-action="BasicIO"><svg class="mr-3 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v14H4zM8 9l3 3-3 3m5 0h3"/></svg>Basic Input-Output</a>
                    <a class="topic-link" aria-current="@(ViewData["Topic"] as string == "NestedIfElse" ? "page" : null)" asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_NestedIfElse" asp-action="Index"><svg class="mr-3 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v5m0 0H5v6m7-6h7v6M3 14h4v6H3zm14 0h4v6h-4z"/></svg>Nested If...Else</a>
                    <a class="topic-link" aria-current="@(ViewData["Topic"] as string == "Loops" ? "page" : null)" asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Loops" asp-action="Index"><svg class="mr-3 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5M6 7a7 7 0 0 1 12-1l2 1M4 17l2 1a7 7 0 0 0 12-1"/></svg>Loops</a>
                    <a class="topic-link" aria-current="@(ViewData["Topic"] as string == "Arrays" ? "page" : null)" asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Arrays" asp-action="Index"><svg class="mr-3 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h6v6H3zm12 0h6v6h-6zM3 14h6v6H3zm12 0h6v6h-6z"/></svg>Arrays</a>
                </nav>
            </details>
        </aside>
        <main id="main-content" tabindex="-1" class="min-w-0 px-5 py-9 sm:px-9 lg:px-14 lg:py-12">
            <div class="mx-auto max-w-4xl">
                @RenderBody()
                <footer class="mt-12 text-sm text-stone-600">Fundamental of Programming &middot; PICARDOCHRISTOPHERJOHN_24-1635</footer>
            </div>
        </main>
    </div>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
