<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Christopher John Picardo's Fundamental of Programming course project: input-output, decisions, loops, and arrays." />
    <title>@ViewData["Title"] | Fundamental of Programming</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-white text-stone-900 antialiased">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="flex min-h-18 flex-wrap items-center justify-between gap-3 bg-white px-5 py-4 lg:px-8">
        <a class="text-lg font-bold tracking-tight" asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Home" asp-action="Index">Fundamental of Programming<span class="text-course-green">.</span></a>
        <p class="text-sm text-stone-600">Christopher John Picardo <span class="ml-2">24-1635</span></p>
    </header>
    <div class="bg-stone-900 px-5 py-3 text-sm text-white lg:px-8">C# learning notebook</div>
    <div class="lg:grid lg:grid-cols-[248px_minmax(0,1fr)]">
        <aside class="bg-course-sidebar px-5 py-5 lg:min-h-[calc(100vh-116px)] lg:px-6 lg:py-9">
            <details class="topic-menu">
                <summary class="cursor-pointer py-2 font-semibold">Course contents</summary>
                <nav aria-label="Course contents" class="mt-4 flex flex-col gap-1">
                    <a class="topic-link" aria-current="@(ViewData["Topic"] as string == "BasicIO" ? "page" : null)" asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Home" asp-action="BasicIO">Basic Input-Output</a>
                    <a class="topic-link" aria-current="@(ViewData["Topic"] as string == "NestedIfElse" ? "page" : null)" asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Home" asp-action="NestedIfElse">Nested If...Else</a>
                    <a class="topic-link" aria-current="@(ViewData["Topic"] as string == "Loops" ? "page" : null)" asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Home" asp-action="Loops">Loops</a>
                    <a class="topic-link" aria-current="@(ViewData["Topic"] as string == "Arrays" ? "page" : null)" asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Home" asp-action="Arrays">Arrays</a>
                </nav>
            </details>
        </aside>
        <main id="main-content" tabindex="-1" class="min-w-0 px-5 py-9 sm:px-9 lg:px-14 lg:py-12">
            <div class="mx-auto max-w-4xl">
                @RenderBody()
                <footer class="mt-12 text-sm text-stone-600">Fundamental of Programming &middot; PICARDOCHRISTOPHERJOHN_24-1635</footer>
            </div>
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
