@model PICARDOCHRISTOPHERJOHN_24_1635_LoopsPageModel

@{
    ViewData["Title"] = "Loops";
    ViewData["Topic"] = "Loops";
}

<h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Loops</h1>
<p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-700 sm:text-lg">One for-loop example, two while-loop examples, and two do...while-loop examples.</p>
<details class="example-menu mt-5">
    <summary class="min-h-11 cursor-pointer py-2 font-semibold">Examples on this page</summary>
    <nav aria-label="Examples on this page" class="mt-2 flex flex-wrap gap-x-5 gap-y-3">
    <a class="inline-flex min-h-11 items-center text-course-green underline underline-offset-4" href="#table">Multiplication Table</a>
    <a class="inline-flex min-h-11 items-center text-course-green underline underline-offset-4" href="#count">Count from 1 to N</a>
    <a class="inline-flex min-h-11 items-center text-course-green underline underline-offset-4" href="#star-line">Star Line</a>
    <a class="inline-flex min-h-11 items-center text-course-green underline underline-offset-4" href="#countdown">Countdown to Zero</a>
    <a class="inline-flex min-h-11 items-center text-course-green underline underline-offset-4" href="#star-triangle">Star Triangle</a>
    </nav>
</details>
<partial name="PICARDOCHRISTOPHERJOHN_24-1635_validation" />

<section id="table" aria-labelledby="table-title" class="example">
    <h2 id="table-title" class="text-2xl font-semibold tracking-tight">Multiplication Table</h2>
    <p class="mt-3 leading-relaxed text-stone-700">For loop: multiply a number by 1 through 10.</p>
    <form asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Loops" asp-action="Table" asp-fragment="table" method="post" class="example-form">
            <div>
                <label asp-for="Table.Number" class="form-label">Number (1–100)</label>
                <input asp-for="Table.Number" type="number" step="1" min="1" max="100" required class="form-input" aria-describedby="Table_Number-error" />
                <span asp-validation-for="Table.Number" id="Table_Number-error" class="field-error"></span>
            </div>
        <button type="submit" class="action-button">Run example</button>
    </form>
    @if (Model.Table.Result != null)
    {
        <pre class="example-output" role="status" tabindex="-1"><output>@Model.Table.Result</output></pre>
    }
    <details class="mt-6">
        <summary class="min-h-11 cursor-pointer py-2 font-semibold">See the C# logic</summary>
        <pre class="code-example"><code>int number = Number.GetValueOrDefault();
var lines = new List&lt;string&gt;();
for (int multiplier = 1; multiplier &lt;= 10; multiplier++)
{
    lines.Add($"{number} × {multiplier} = {number * multiplier}");
}
Result = string.Join("\n", lines);</code></pre>
    </details>
</section>

<section id="count" aria-labelledby="count-title" class="example">
    <h2 id="count-title" class="text-2xl font-semibold tracking-tight">Count from 1 to N</h2>
    <p class="mt-3 leading-relaxed text-stone-700">While loop: start at 1 and keep counting until N.</p>
    <form asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Loops" asp-action="Count" asp-fragment="count" method="post" class="example-form">
            <div>
                <label asp-for="Count.Limit" class="form-label">Count up to (1–20)</label>
                <input asp-for="Count.Limit" type="number" step="1" min="1" max="20" required class="form-input" aria-describedby="Count_Limit-error" />
                <span asp-validation-for="Count.Limit" id="Count_Limit-error" class="field-error"></span>
            </div>
        <button type="submit" class="action-button">Run example</button>
    </form>
    @if (Model.Count.Result != null)
    {
        <pre class="example-output" role="status" tabindex="-1"><output>@Model.Count.Result</output></pre>
    }
    <details class="mt-6">
        <summary class="min-h-11 cursor-pointer py-2 font-semibold">See the C# logic</summary>
        <pre class="code-example"><code>int current = 1;
var numbers = new List&lt;int&gt;();
while (current &lt;= Limit.GetValueOrDefault())
{
    numbers.Add(current);
    current++;
}
Result = string.Join(", ", numbers);</code></pre>
    </details>
</section>

<section id="star-line" aria-labelledby="star-line-title" class="example">
    <h2 id="star-line-title" class="text-2xl font-semibold tracking-tight">Star Line</h2>
    <p class="mt-3 leading-relaxed text-stone-700">While loop: enter a count to print a straight line of stars.</p>
    <form asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Loops" asp-action="StarLine" asp-fragment="star-line" method="post" class="example-form">
            <div>
                <label asp-for="StarLine.Count" class="form-label">Stars (1–50)</label>
                <input asp-for="StarLine.Count" type="number" step="1" min="1" max="50" required class="form-input" aria-describedby="StarLine_Count-error" />
                <span asp-validation-for="StarLine.Count" id="StarLine_Count-error" class="field-error"></span>
            </div>
        <button type="submit" class="action-button">Run example</button>
    </form>
    @if (Model.StarLine.Result != null)
    {
        <pre class="example-output" role="status" tabindex="-1"><output>@Model.StarLine.Result</output></pre>
    }
    <details class="mt-6">
        <summary class="min-h-11 cursor-pointer py-2 font-semibold">See the C# logic</summary>
        <pre class="code-example"><code>int current = 0;
string stars = "";
while (current &lt; Count.GetValueOrDefault())
{
    stars += "*";
    current++;
}
Result = stars;</code></pre>
    </details>
</section>

<section id="countdown" aria-labelledby="countdown-title" class="example">
    <h2 id="countdown-title" class="text-2xl font-semibold tracking-tight">Countdown to Zero</h2>
    <p class="mt-3 leading-relaxed text-stone-700">Do...while loop: display the starting number, then count down to zero.</p>
    <form asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Loops" asp-action="Countdown" asp-fragment="countdown" method="post" class="example-form">
            <div>
                <label asp-for="Countdown.Start" class="form-label">Start at (1–20)</label>
                <input asp-for="Countdown.Start" type="number" step="1" min="1" max="20" required class="form-input" aria-describedby="Countdown_Start-error" />
                <span asp-validation-for="Countdown.Start" id="Countdown_Start-error" class="field-error"></span>
            </div>
        <button type="submit" class="action-button">Run example</button>
    </form>
    @if (Model.Countdown.Result != null)
    {
        <pre class="example-output" role="status" tabindex="-1"><output>@Model.Countdown.Result</output></pre>
    }
    <details class="mt-6">
        <summary class="min-h-11 cursor-pointer py-2 font-semibold">See the C# logic</summary>
        <pre class="code-example"><code>int current = Start.GetValueOrDefault();
var numbers = new List&lt;int&gt;();
do
{
    numbers.Add(current);
    current--;
}
while (current &gt;= 0);
Result = string.Join(", ", numbers);</code></pre>
    </details>
</section>

<section id="star-triangle" aria-labelledby="star-triangle-title" class="example">
    <h2 id="star-triangle-title" class="text-2xl font-semibold tracking-tight">Star Triangle</h2>
    <p class="mt-3 leading-relaxed text-stone-700">Do...while loop: add one star per row to build a triangle.</p>
    <form asp-controller="PICARDOCHRISTOPHERJOHN_24_1635_Loops" asp-action="StarTriangle" asp-fragment="star-triangle" method="post" class="example-form">
            <div>
                <label asp-for="StarTriangle.Rows" class="form-label">Rows (1–20)</label>
                <input asp-for="StarTriangle.Rows" type="number" step="1" min="1" max="20" required class="form-input" aria-describedby="StarTriangle_Rows-error" />
                <span asp-validation-for="StarTriangle.Rows" id="StarTriangle_Rows-error" class="field-error"></span>
            </div>
        <button type="submit" class="action-button">Run example</button>
    </form>
    @if (Model.StarTriangle.Result != null)
    {
        <pre class="example-output" role="status" tabindex="-1"><output>@Model.StarTriangle.Result</output></pre>
    }
    <details class="mt-6">
        <summary class="min-h-11 cursor-pointer py-2 font-semibold">See the C# logic</summary>
        <pre class="code-example"><code>int row = 1;
string stars = "";
var lines = new List&lt;string&gt;();
do
{
    stars += "*";
    lines.Add(stars);
    row++;
}
while (row &lt;= Rows.GetValueOrDefault());
Result = string.Join("\n", lines);</code></pre>
    </details>
</section>
